#### QUESTION 2
c1s<-c(162, 22, 2, 14)
c1n<-c(6,22,12,160)
c2s<-c(76,70,14,40)
c2n<-c(8,52,22,118)
c1s
c1n
c2s
c2n
## convert to proportions
pc1s<-c1s/sum(c1s)
pc1n<-c1n/sum(c1n)
pc2s<-c2s/sum(c2s)
pc2n<-c2n/sum(c2n)
pc1s
pc1n
pc2s
pc2n
## cumulative proportions
hitc1<-cumsum(pc1s)[-length(pc1s)]
hitc1
## cumulative proportions
hitc1<-cumsum(pc1s)[-length(pc1s)]
fac1<-sumsum(pc1n)[-length(pc1n)]
fac1<-cumsum(pc1n)[-length(pc1n)]
hitc2<-cumsum(pc2s)[-length(pc2s)]
fac2<-cumsum(pc2n)[-length(pc2n)]
hitc1
fac1
hitc2
fac2
## dprime
dprimec1<-qnorm(hitc1)-qnorm(fac1)
dprimec2<-qnorm(hitc2)-qnorm(fac2)
dprimec1
dprimec2
## criterion
c1<--0.5*(qnorm(hitc1)+qnorm(fac1))
## criterion
c1<--0.5*(qnorm(hitc1)+qnorm(fac1))
c2<--0.5*(qnorm(hitc2)+qnorm(fac2))
c1
c2
plot(fac1, hitc1, xlim=c(0,1), ylim=c(0,1), pch=19, col="black",
xlab="Proportion FA", ylab="Proportion Hits")
## create a panel with 2 subplots
par(mfrow=c(2,1)) # 2 rows, 1 column
plot(fac1, hitc1, xlim=c(0,1), ylim=c(0,1), pch=19, col="black",
xlab="Proportion FA", ylab="Proportion Hits")
plot(fac1, hitc1, xlim=c(0,1), ylim=c(0,1), pch=19, col="black",
xlab="Proportion FA", ylab="Proportion Hits", type='b')
graphics.off()
## create a panel with 2 subplots
par(mfrow=c(2,1)) # 2 rows, 1 column
plot(fac1, hitc1, xlim=c(0,1), ylim=c(0,1), pch=19, col="black",
xlab="Proportion FA", ylab="Proportion Hits", type='b')
points(fac2, hitc2, pch=19, col="red", type='b')
abline(0,1)
?pch
